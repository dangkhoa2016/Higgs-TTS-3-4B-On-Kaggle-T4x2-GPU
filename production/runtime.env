# Canonical Higgs TTS 3 T4x2 runtime configuration
HIGGS_MODEL_PATH=${HIGGS_MODEL_PATH:-/kaggle/input/models/dangkhoa2016/bosonai-higgs-tts-3-4b/transformers/default/1}
HIGGS_HOST=${HIGGS_HOST:-127.0.0.1}
HIGGS_PORT=${HIGGS_PORT:-8000}
HIGGS_TTS_GPU=${HIGGS_TTS_GPU:-0}
HIGGS_AUX_GPU=${HIGGS_AUX_GPU:-1}
HIGGS_MEM_FRACTION_STATIC=${HIGGS_MEM_FRACTION_STATIC:-0.72}
HIGGS_DTYPE=${HIGGS_DTYPE:-float16}
HIGGS_MAX_RUNNING_REQUESTS=${HIGGS_MAX_RUNNING_REQUESTS:-1}
HIGGS_SAMPLING_BACKEND=${HIGGS_SAMPLING_BACKEND:-pytorch}
HIGGS_ATTENTION_BACKEND=${HIGGS_ATTENTION_BACKEND:-triton}
